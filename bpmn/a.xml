        <di:waypoint x="1318" y="282"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="1336" y="300"/>
        <di:waypoint x="1390" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="1570" y="300"/>
        <di:waypoint x="1705" y="300"/>
        <di:waypoint x="1705" y="440"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="1800" y="480"/>
        <di:waypoint x="1840" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">
        <di:waypoint x="2030" y="480"/>
        <di:waypoint x="2105" y="480"/>
        <di:waypoint x="2105" y="325"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="2130" y="325"/>
        <di:waypoint x="2200" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="2410" y="360"/>
        <di:waypoint x="2460" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="2670" y="360"/>
        <di:waypoint x="2815" y="360"/>
        <di:waypoint x="2815" y="560"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="2910" y="600"/>
        <di:waypoint x="3085" y="600"/>
        <di:waypoint x="3085" y="440"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="3190" y="480"/>
        <di:waypoint x="3265" y="480"/>
        <di:waypoint x="3265" y="385"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="3290" y="360"/>
        <di:waypoint x="3360" y="340"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <di:waypoint x="3570" y="340"/>
        <di:waypoint x="3620" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17">
        <di:waypoint x="3265" y="385"/>
        <di:waypoint x="3360" y="420"/>
