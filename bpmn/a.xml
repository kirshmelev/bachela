        <dc:Bounds x="2980" y="680" width="210" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ArchiveStateTransfer_di" bpmnElement="Task_ArchiveStateTransfer">
        <dc:Bounds x="3240" y="220" width="210" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_StateDone_di" bpmnElement="EndEvent_StateDone">
        <dc:Bounds x="3500" y="242" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ApplyAccessRules_di" bpmnElement="Task_ApplyAccessRules">
        <dc:Bounds x="2200" y="320" width="210" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyInterestedParties_di" bpmnElement="Task_NotifyInterestedParties">
        <dc:Bounds x="2460" y="320" width="210" height="80"/>
      </bpmndi:BPMNShape>
