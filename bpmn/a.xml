        <dc:Bounds x="2980" y="440" width="210" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AccessGranted_di" bpmnElement="Gateway_AccessGranted" isMarkerVisible="true">
        <dc:Bounds x="3240" y="335" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DiscloseAllowedInfo_di" bpmnElement="Task_DiscloseAllowedInfo">
        <dc:Bounds x="3360" y="300" width="210" height="80"/>
      </bpmndi:BPMNShape>
