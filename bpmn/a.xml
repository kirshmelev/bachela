      <bpmndi:BPMNShape id="Task_RequestInheritanceCase_di" bpmnElement="Task_RequestInheritanceCase">
        <dc:Bounds x="1610" y="440" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckHeirsStatus_di" bpmnElement="Task_CheckHeirsStatus">
        <dc:Bounds x="1840" y="440" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HeirsExist_di" bpmnElement="Gateway_HeirsExist" isMarkerVisible="true">
        <dc:Bounds x="2080" y="275" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ClassifyEscheat_di" bpmnElement="Task_ClassifyEscheat">
        <dc:Bounds x="2200" y="220" width="210" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareStatePackage_di" bpmnElement="Task_PrepareStatePackage">
        <dc:Bounds x="2460" y="220" width="210" height="80"/>
      </bpmndi:BPMNShape>
